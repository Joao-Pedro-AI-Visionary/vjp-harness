{
  "_comment": "Config provider-agnostic dos agentes. Use em QUALQUER lugar: escolha um preset (ou aponte provider/baseUrl direto), e defina o modelo. Tudo pode ser sobrescrito por ENV sem editar este arquivo: VJP_LLM_PRESET, VJP_LLM_PROVIDER, VJP_LLM_BASE_URL, VJP_LLM_MODEL, VJP_LLM_API_KEY_ENV. A API key vem da env nomeada em apiKeyEnv (nunca commite a key). Fixar um modelo é OPCIONAL — só serve para reproduzir um projeto.",
  "llm": {
    "preset": "cliproxy",
    "model": "",
    "apiKeyEnv": "VJP_LLM_API_KEY",
    "temperature": 0,
    "maxTokens": 4096,
    "timeoutMs": 180000
  },
  "presets": {
    "cliproxy":   { "provider": "openai",    "baseUrl": "http://localhost:8317/v1" },
    "openai":     { "provider": "openai",    "baseUrl": "https://api.openai.com/v1" },
    "deepseek":   { "provider": "openai",    "baseUrl": "https://api.deepseek.com/v1" },
    "kimi":       { "provider": "openai",    "baseUrl": "https://api.moonshot.cn/v1" },
    "glm":        { "provider": "openai",    "baseUrl": "https://open.bigmodel.cn/api/paas/v4" },
    "minimax":    { "provider": "openai",    "baseUrl": "https://api.minimaxi.com/v1" },
    "openrouter": { "provider": "openai",    "baseUrl": "https://openrouter.ai/api/v1" },
    "groq":       { "provider": "openai",    "baseUrl": "https://api.groq.com/openai/v1" },
    "together":   { "provider": "openai",    "baseUrl": "https://api.together.xyz/v1" },
    "anthropic":  { "provider": "anthropic", "baseUrl": "https://api.anthropic.com" },
    "ollama":     { "provider": "ollama",    "baseUrl": "http://localhost:11434" }
  },
  "agents": {
    "planner": { "model": null },
    "researcher": { "model": null },
    "executor": { "model": null },
    "reviewer": { "model": null }
  },
  "pipeline": {
    "maxRetries": 2,
    "testCommand": "npm test",
    "autoMerge": true
  }
}
