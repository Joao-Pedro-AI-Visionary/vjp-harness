#!/bin/sh
# Guard de mensagem de commit — padrao V-JP.
# Spec: docs/superpowers/specs/2026-08-05-git-commit-msg-guard-design.md
#
# Exige:  [jp] feat|fix(escopo): descricao
#   feat = coisa nova   |   fix = bug ou qualquer correcao pequena
#   escopo e opcional (ver D-02 do spec)
#
# Escapes: merge/revert/fixup passam direto; `git commit --no-verify` pula tudo.
# Desinstalar: git config --global --unset core.hooksPath

MSG_FILE="$1"

# Primeira linha util: ignora comentarios e linhas em branco.
SUBJECT=$(grep -v '^#' "$MSG_FILE" | sed '/^[[:space:]]*$/d' | head -1)

# Mensagens que o proprio git gera.
case "$SUBJECT" in
  Merge\ *|Revert\ *|Reapply\ *|fixup!\ *|squash!\ *|amend!\ *) exit 0 ;;
esac

if ! printf '%s' "$SUBJECT" | grep -qE '^\[jp\] (feat|fix)(\([a-zA-Z0-9._/-]+\))?: .+'; then
  printf '\n\033[31m❌ Commit recusado — padrão V-JP\033[0m\n\n'
  printf '   Formato:  \033[1m[jp] feat|fix(escopo): descricao\033[0m\n\n'
  printf '   feat = coisa nova\n'
  printf '   fix  = bug ou qualquer correção pequena\n\n'
  printf '   Exemplo: [jp] fix(header): logo somia no mobile\n\n'
  printf '   Sua mensagem: "%s"\n\n' "$SUBJECT"
  printf '   (para pular uma vez: git commit --no-verify)\n\n'
  exit 1
fi

# Nao atropela hook local do repo, se existir (D-01 do spec).
GITDIR=$(git rev-parse --git-common-dir 2>/dev/null)
LOCAL="$GITDIR/hooks/commit-msg"
[ -x "$LOCAL" ] && exec "$LOCAL" "$@"

exit 0
